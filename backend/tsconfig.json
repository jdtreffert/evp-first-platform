{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,

    "baseUrl": ".",
    "paths": {
      "src/*": ["src/*"]
    }
  },

  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**"]
}
