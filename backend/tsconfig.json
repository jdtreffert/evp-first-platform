{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,

    "baseUrl": ".",
    "paths": {
      "src/*": ["src/*"]
    }
  },

  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
