PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Generate both with a cryptographically secure random generator (at least 32 chars).
AUTH_SESSION_SECRET=replace-with-random-secret-at-least-32-characters
ADMIN_BOOTSTRAP_SECRET=replace-with-a-separate-random-secret

# Optional SMTP submission settings. Without SMTP_HOST/SMTP_FROM, OTP delivery returns 503.
# Port 587 uses STARTTLS; port 465 uses implicit TLS. TLS is required for delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Use a verified sender address from your mail provider.
SMTP_FROM=
# Supply both only when your provider requires SMTP authentication.
SMTP_USER=
SMTP_PASSWORD=

EVP_DATA_FILE=data/events.json
EVP_AUTH_FILE=data/auth.json
